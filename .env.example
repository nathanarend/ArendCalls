# Chave Mestra global para autenticação na API do ArendCalls (obrigatória em produção)
API_KEY=sua_chave_mestra_secreta_aqui

# Intervalo do worker de keepalive de presença do WhatsApp (padrão: 24h)
# Suporta durações Go (ex: 24h, 12h, 30m, 1h)
WA_PRESENCE_INTERVAL=24h

# Alternativa numérica em horas para o intervalo de presença
# WA_PRESENCE_INTERVAL_HOURS=24

# Chave AES-256-GCM para criptografia de credenciais B2 e Webhooks no banco SQLite
# Necessário apenas se for utilizar o recurso de gravação no servidor (32+ caracteres)
# RECORDING_CONFIG_KEY=sua_chave_aes_de_32_bytes_aqui

# Ajustes de performance do runtime Go (recomendado em produção)
GOGC=200
# GOMEMLIMIT=1500MiB
