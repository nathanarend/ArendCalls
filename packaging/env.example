# Configuracao do ArendCalls. Copie para ".env" (o iniciar faz isso na primeira
# vez) e preencha. O .env nao vem no pacote: extrair uma versao nova por cima
# nao apaga a sua configuracao.
#
# Formato: CHAVE=valor, uma por linha, SEM aspas. Linhas com # sao ignoradas.

# Chave mestra da API (obrigatoria). Use algo longo e aleatorio.
API_KEY=troque_esta_chave

# Endereco do painel e da API.
#   127.0.0.1:8080 -> so nesta maquina (use com Cloudflare Tunnel ou proxy)
#   :8080          -> aberto na rede (libere a porta no firewall)
ADDR=127.0.0.1:8080

# Login do painel (obrigatorio se o painel ficar acessivel pela internet).
# Gere o hash com:  arendcalls -hash-password   (Windows: arendcalls.exe -hash-password)
# ADMIN_USER=admin
# ADMIN_PASSWORD_HASH=

# Chave para cifrar as credenciais de gravacao (B2/webhook) no banco.
# Defina antes de configurar a gravacao no painel (32+ caracteres).
# RECORDING_CONFIG_KEY=

# Hora local (0-23) da checagem diaria da versao do cliente WhatsApp.
# WA_VERSION_CHECK_HOUR=3

# Keepalive de presenca do WhatsApp (duracao Go: 24h, 12h, 30m).
# WA_PRESENCE_INTERVAL=24h

# Pre-buffer da reproducao no painel, em ms (0-500).
# AUDIO_PREBUFFER_MS_WEBRTC=0
# AUDIO_PREBUFFER_MS_WEBSOCKET=60

# Runtime Go: menos CPU em coleta de lixo durante as chamadas.
GOGC=200
# GOMEMLIMIT=1500MiB

# So Windows: 1 abre um Cloudflare quick tunnel (URL trycloudflare.com) numa
# janela separada, se o cloudflared estiver instalado.
# CLOUDFLARE_QUICK_TUNNEL=1
